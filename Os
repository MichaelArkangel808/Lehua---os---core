    speak("Welcome to Lehua OS. Which system would you like to activate?")
    
    while True:
        speak("Options: [1] Finance Bot, [2] Dashboard, [3] Guardian Mode, [4] Keys, [5] Exit")
        choice = ask("Enter option number")
        
        if choice == "1":
            from modules.finance_automation.finance_bot import run_bot
            run_bot()
        elif choice == "2":
            from modules.finance_automation.dashboard import launch_dashboard
            launch_dashboard()
        elif choice == "3":
            from modules.guardian.guardian_bracelet import guardian_mode
            guardian_mode()
        elif choice == "4":
            from modules.sovereign.crypto_keys import generate_keys
            generate_keys()
        elif choice == "5":
